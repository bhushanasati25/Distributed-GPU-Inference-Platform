# =============================================================================
# Triton Preprocessing Model Configuration (Python Backend)
# =============================================================================
name: "image_preprocess"
backend: "python"
max_batch_size: 64

input [
  {
    name: "raw_image_bytes"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "preprocessed_tensor"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

