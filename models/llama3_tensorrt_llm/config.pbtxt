# =============================================================================
# NVIDIA Triton TensorRT-LLM Model Configuration: LLaMA-3 (Continuous Batching)
# =============================================================================
name: "llama3_8b_trtllm"
backend: "tensorrt_llm"
max_batch_size: 128

# Key-Value Cache & PagedAttention Memory Configuration
parameters: {
  key: "kv_cache_free_gpu_mem_fraction"
  value: { string_value: "0.85" } # Reserve 85% of GPU VRAM for KV cache pages
}
parameters: {
  key: "max_num_seqs"
  value: { string_value: "128" }  # Max concurrent in-flight sequences
}
parameters: {
  key: "max_beam_width"
  value: { string_value: "1" }
}
parameters: {
  key: "batch_scheduler_policy"
  value: { string_value: "guaranteed_completion" }
}

# Inputs
input [
  {
    name: "input_ids"
    data_type: TYPE_INT32
    dims: [ -1 ]
  },
  {
    name: "request_output_len"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

# Outputs
output [
  {
    name: "output_ids"
    data_type: TYPE_INT32
    dims: [ -1, -1 ]
  }
]

# Multi-GPU Tensor Parallelism across GPU Pool nodes
instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0, 1 ] # Tensor parallel across 2 GPUs in the pool
  }
]

