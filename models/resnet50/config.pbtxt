# =============================================================================
# NVIDIA Triton Model Configuration: ResNet-50 (TensorRT Engine)
# =============================================================================
name: "resnet50"
platform: "tensorrt_plan"
max_batch_size: 64

# Input Tensor Specification
input [
  {
    name: "input_0"
    data_type: TYPE_FP32
    format: FORMAT_NCHW
    dims: [ 3, 224, 224 ]
  }
]

# Output Tensor Specification
output [
  {
    name: "output_0"
    data_type: TYPE_FP32
    dims: [ 1000 ]
  }
]

# Dynamic Batching Configuration
# Assembles individual inference requests into optimal batches to saturate GPU cores
dynamic_batching {
  preferred_batch_size: [ 8, 16, 32, 64 ]
  max_queue_delay_microseconds: 2000
}

# GPU Instance Group Configuration
# Spawns 2 execution engine instances per GPU to overlap compute and PCIe transfers
instance_group [
  {
    count: 2
    kind: KIND_GPU
  }
]

# Optimization Settings
optimization {
  execution_accelerators {
    gpu_execution_accelerator : [ {
      name : "tensorrt"
      parameters { key: "precision_mode" value: "FP16" }
      parameters { key: "max_workspace_size_bytes" value: "4294967296" } # 4GB
    }]
  }
}

# Version Policy: serve latest version
version_policy: { latest { num_versions: 1 } }

