# =============================================================================
# Distributed GPU Inference Platform — Environment Template
# =============================================================================

# Go Router Configuration
ROUTER_SERVER_GRPC_PORT=50051
ROUTER_SERVER_HTTP_PORT=8080
ROUTER_SERVER_METRICS_PORT=9090
ROUTER_SERVER_LOG_LEVEL=info

# Load Balancing Tuning Weights (Alpha: in-flight, Beta: latency, Gamma: queue)
ROUTER_LOAD_BALANCING_ALGORITHM=latency_aware
ROUTER_LOAD_BALANCING_ALPHA=0.40
ROUTER_LOAD_BALANCING_BETA=0.40
ROUTER_LOAD_BALANCING_GAMMA=0.20

# Request Queue Limits
ROUTER_QUEUE_MAX_DEPTH=10000
ROUTER_QUEUE_DEFAULT_TIMEOUT=5s

# Redis Semantic & Tensor Cache
ROUTER_REDIS_ENABLED=true
ROUTER_REDIS_ADDRESS=localhost:6379
ROUTER_REDIS_PASSWORD=
ROUTER_REDIS_DB=0
ROUTER_REDIS_TTL=60s

# NVIDIA Triton & Storage Endpoints
TRITON_HTTP_URL=http://localhost:8000
TRITON_GRPC_URL=localhost:8001
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Observability
PROMETHEUS_URL=http://localhost:9090
JAEGER_OTLP_ENDPOINT=http://localhost:4317
